# Frontend env — local development.
#
# The frontend bundle is now tenant-portable.  Provider mode and
# Entra IDs are served by the backend at GET /config and resolved
# in the browser at startup (see src/contexts/ConfigContext.tsx).
# The only build-time-needed value is the backend URL itself.

# Backend API base URL.
# Leave blank for the bundled deploy (frontend served from same
# origin as backend).  Set to an absolute URL when running the
# frontend dev server (pnpm dev) against a separate backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ── Supabase mode only ───────────────────────────────────────────────────────
# Required if your backend has AUTH_PROVIDER=supabase.  Leave both
# unset for local / entra modes; the bundle will not construct the
# supabase client at all.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key
