{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom": [
        "node_modules/@types/react-dom/index.d.ts"
      ],
      "lucide-react": [
        "node_modules/lucide-react"
      ],
      "clsx": [
        "node_modules/clsx"
      ],
      "tailwind-merge": [
        "node_modules/tailwind-merge"
      ],
      "@mike/edit-card-ui": [
        "../frontend/src/shared/ui/EditCardUI.tsx"
      ],
      "@mike/edit-cards-section-ui": [
        "../frontend/src/shared/ui/EditCardsSectionUI.tsx"
      ],
      "@mike/pre-response-wrapper-ui": [
        "../frontend/src/shared/ui/PreResponseWrapperUI.tsx"
      ],
      "@mike/document-event-blocks-ui": [
        "../frontend/src/shared/ui/DocumentEventBlocksUI.tsx"
      ],
      "@mike/glass-card-ui": [
        "../frontend/src/shared/ui/GlassCardUI.tsx"
      ],
      "@mike/modal-ui": [
        "../frontend/src/shared/ui/ModalUI.tsx"
      ],
      "@mike/header-buttons-ui": [
        "../frontend/src/shared/ui/HeaderButtonsUI.tsx"
      ],
      "@mike/pill-button-ui": [
        "../frontend/src/shared/ui/PillButtonUI.tsx"
      ]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
