{
  "name": "mike-word-addin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "typecheck": "tsc --noEmit",
    "build": "webpack --mode production && node scripts/build-manifest.js",
    "prestart": "node scripts/clear-sideload.js",
    "start": "office-addin-debugging start manifest.xml --dev-server \"pnpm run dev\" --dev-server-port 3000",
    "stop": "office-addin-debugging stop manifest.xml",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/office-js": "^1.0.400",
    "@types/office-runtime": "^1.0.38",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^5.0.12",
    "office-addin-dev-certs": "^2.0.9",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "semver": "^7.8.5",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "packageManager": "pnpm@11.1.2"
}
