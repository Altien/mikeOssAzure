{
  "name": "mike-word-addin",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "office-addin-debugging start manifest.xml --dev-server \"pnpm run dev:server\" --dev-server-port 3200",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm typecheck && webpack --mode production && node scripts/build-manifest.js",
    "prestart": "node scripts/clear-sideload.js",
    "start": "office-addin-debugging start manifest.xml --dev-server \"pnpm run dev:server\" --dev-server-port 3200",
    "stop": "office-addin-debugging stop manifest.xml",
    "preinstall": "npx only-allow pnpm",
    "predev": "node scripts/clear-sideload.js",
    "dev:server": "webpack serve --mode development"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^26.4.1",
    "@types/office-js": "^1.0.608",
    "@types/office-runtime": "^1.0.40",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.9",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.0",
    "semver": "^7.8.5",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "ts-loader": "^9.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "overrides": {}
}
