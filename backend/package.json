{
  "name": "mike-backend",
  "version": "0.3.0-azure.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.cjs",
    "dev": "tsx watch --import ./dev-log.mjs src/index.ts",
    "dev:nolog": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:contracts": "tsc -p ../packages/contracts/tsconfig.json",
    "sync:workflows": "node dist/jobs/syncWorkflows.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:canary": "vitest run --config vitest.canary.config.ts",
    "test:mutation": "stryker run",
    "chat:inspect": "tsx src/scripts/inspect-chat.ts",
    "smoke:skills": "tsx src/scripts/skillsSmoke.ts",
    "check:matching": "tsx src/scripts/capabilityMatchCheck.ts",
    "prestart": "node scripts/check-node-version.cjs",
    "start": "node --enable-source-maps dist/index.js",
    "migrate": "node dist/scripts/runMigrations.js",
    "migrate:dev": "tsx src/scripts/runMigrations.ts",
    "migrate:local": "tsx src/scripts/migrateLocal.ts",
    "migrate:legacy": "node-pg-migrate up --migrations-dir migrations --migration-file-language sql --ignore-pattern \".*\\.md\"",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migration-file-language sql --ignore-pattern \".*\\.md\"",
    "azurite:init": "tsx src/scripts/initAzurite.ts",
    "setup:local": "node ../scripts/local-setup.mjs",
    "migrate:user-api-keys": "node dist/scripts/migrate-user-api-keys.js",
    "migrate:user-api-keys:dev": "tsx src/scripts/migrate-user-api-keys.ts",
    "preinstall": "npx only-allow pnpm",
    "backfill:document-text": "node dist/jobs/backfillDocumentText.js"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.134",
    "@ai-sdk/anthropic": "^4.0.98",
    "@ai-sdk/azure": "^4.0.118",
    "@ai-sdk/google": "^4.0.113",
    "@ai-sdk/google-vertex": "^5.0.133",
    "@ai-sdk/mistral": "^4.0.80",
    "@ai-sdk/openai": "^4.0.77",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/xai": "^5.0.39",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.26.0",
    "@google/genai": "^1.50.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@sentry/node": "11.11.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/pg": "^8.20.0",
    "ai": "^7.0.164",
    "applicationinsights": "^3.14.0",
    "bullmq": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "defuddle": "^0.19.6",
    "docx": "^9.15.3",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "fast-xml-parser": "^5.12.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.1.0",
    "html-to-text": "10.0.1",
    "ioredis": "^6.0.0",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.2",
    "libreoffice-convert": "^1.9.1",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.2",
    "node-html-markdown": "2.0.0",
    "node-pg-migrate": "^7.9.1",
    "openai": "^6.36.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.20.0",
    "postal-mime": "^4.2.1",
    "undici": "^8.12.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.21",
    "@babel/parser": "^8.1.2",
    "@babel/types": "^8.0.8",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/html-to-text": "9.0.4",
    "@types/multer": "^1.4.13",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "only-allow": "^1.2.1",
    "semver": "^7.8.5",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.1.2",
  "overrides": {}
}
