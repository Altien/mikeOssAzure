{
  "name": "mike-backend",
  "version": "0.3.0-azure.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --import ./dev-log.mjs src/index.ts",
    "dev:nolog": "tsx watch src/index.ts",
    "build": "tsc",
    "sync:workflows": "node dist/jobs/syncWorkflows.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "chat:inspect": "tsx src/scripts/inspect-chat.ts",
    "smoke:skills": "tsx src/scripts/skillsSmoke.ts",
    "check:matching": "tsx src/scripts/capabilityMatchCheck.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/scripts/runMigrations.js",
    "migrate:dev": "tsx src/scripts/runMigrations.ts",
    "migrate:local": "tsx src/scripts/migrateLocal.ts",
    "migrate:legacy": "node-pg-migrate up --migrations-dir migrations --migration-file-language sql --ignore-pattern \".*\\.md\"",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migration-file-language sql --ignore-pattern \".*\\.md\"",
    "azurite:init": "tsx src/scripts/initAzurite.ts",
    "setup:local": "node ../scripts/local-setup.mjs",
    "migrate:user-api-keys": "node dist/scripts/migrate-user-api-keys.js",
    "migrate:user-api-keys:dev": "tsx src/scripts/migrate-user-api-keys.ts",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/azure": "^4.0.45",
    "@ai-sdk/google": "^4.0.68",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.26.0",
    "@google/genai": "^1.50.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@supabase/supabase-js": "^2.105.3",
    "@types/pg": "^8.20.0",
    "ai": "^7.0.98",
    "applicationinsights": "^3.14.0",
    "cookie-parser": "^1.4.7",
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "docx": "^9.5.0",
    "dotenv": "^17.4.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "fast-diff": "^1.3.0",
    "fast-xml-parser": "^5.7.1",
    "helmet": "^8.1.0",
    "html-to-text": "10.0.1",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "libreoffice-convert": "^1.6.0",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.2",
    "node-pg-migrate": "^7.9.1",
    "openai": "^6.36.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.20.0",
    "undici": "^8.10.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "zod": "^4.5.4",
    "@supabase/ssr": "^0.12.6",
    "resend": "^6.28.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/html-to-text": "9.0.4",
    "@types/multer": "^1.4.13",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "only-allow": "^1.2.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.1.2",
  "overrides": {}
}
