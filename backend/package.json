{
  "name": "mike-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node dist/scripts/runMigrations.js",
    "migrate:dev": "tsx src/scripts/runMigrations.ts",
    "migrate:legacy": "node-pg-migrate up --migrations-dir migrations --migration-file-language sql",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migration-file-language sql",
    "migrate:user-api-keys": "node dist/scripts/migrate-user-api-keys.js",
    "migrate:user-api-keys:dev": "tsx src/scripts/migrate-user-api-keys.ts",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.26.0",
    "@google/genai": "^1.50.1",
    "@supabase/supabase-js": "^2.105.3",
    "@types/pg": "^8.20.0",
    "applicationinsights": "^3.14.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.5.0",
    "dotenv": "^17.4.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "fast-diff": "^1.3.0",
    "fast-xml-parser": "^5.7.1",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "libreoffice-convert": "^1.6.0",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.2",
    "node-pg-migrate": "^7.9.1",
    "openai": "^6.36.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.1",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "only-allow": "^1.2.1"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.1.2"
}
