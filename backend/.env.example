NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Public backend origin for OAuth callbacks, without an /api path.
API_PUBLIC_URL=http://localhost:3001
# Public task-pane origin for deployed Word add-ins. Local development uses the
# same-origin webpack proxy and does not need this entry.
WORD_ADDIN_URL=
# Required in local mode before backend listen. Generate each independently:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Production secrets are created once by the migration job under a PG lock and
# read from Key Vault; never bake them into an image or rotate on redeploy.
AUTH_STATE_SECRET=
AUTH_SESSION_ENCRYPTION_SECRET=
AUTH_HANDOFF_ENCRYPTION_SECRET=
# Defaults to 120 seconds and is constrained to 30-300 seconds.
AUTH_HANDOFF_TTL_SECONDS=120
# Optional comma-separated origins for additional trusted clients.
ALLOWED_ORIGINS=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Provider switch: "local" (Docker stack) | "supabase" (hosted) | "entra" (Azure)
AUTH_PROVIDER=local

# Optional public login-page demo notice. Keep false for normal self-hosted use.
DEMO_MODE=false

# Local mode — required when AUTH_PROVIDER=local (docs/runbook-local-stack.md)
# JWT_SECRET must match PGRST_JWT_SECRET in docker-compose.dev.yml.
JWT_SECRET=local-dev-secret-change-me-please-32chars-min

# Supabase mode — required when AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-supabase-service-role-key
# SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key

# Entra mode — required when AUTH_PROVIDER=entra (added in issue 009)
# ENTRA_TENANT_ID=your-azure-ad-tenant-guid
# ENTRA_BACKEND_CLIENT_ID=your-backend-app-registration-client-id
# Backend-owned OpenID login flow, modelled on MatterAI:
# ENTRA_CLIENT_ID=your-web-or-spa-app-registration-client-id
# ENTRA_CLIENT_SECRET=your-web-app-client-secret
# ENTRA_BACKEND_SCOPE=api://your-backend-app-registration-client-id/access_as_user
# ENTRA_REDIRECT_URI=http://localhost:3001/api/auth/openid-callback/microsoft
# BACKEND_PUBLIC_URL=http://localhost:3001
# ENTRA_ADMIN_GROUP_IDS=group-oid-1,group-oid-2
# ENTRA_MEMBER_GROUP_IDS=group-oid-3
# TENANT_ONBOARDING_MODE=manual
# Background upload processing. Each backend replica may process this many jobs
# concurrently, while the per-user cap prevents one large batch from occupying
# the entire pool. Invalid values use these defaults; concurrency is capped at
# 64 and the per-user value cannot exceed the process-wide concurrency.
UPLOAD_PROCESSING_CONCURRENCY=8
UPLOAD_PROCESSING_MAX_RUNNING_PER_USER=2

# ── Data plane ───────────────────────────────────────────────────────────────
# The supabase-js client targets <SUPABASE_URL>/rest/v1/* — but the
# wrapper in lib/supabase.ts strips that prefix for local + entra
# modes, so SUPABASE_URL points at PostgREST directly (no proxy).
# SUPABASE_SECRET_KEY in local mode is a JWT signed with JWT_SECRET
# claiming role=service_role; mint with
# scripts/local-stack/forge-jwt.mjs --role service_role.
SUPABASE_URL=http://localhost:4000
SUPABASE_SECRET_KEY=paste-service-role-jwt-here

# ── Storage ──────────────────────────────────────────────────────────────────
# Azure Blob Storage (production) — use one of:
#   AZURE_STORAGE_ACCOUNT_NAME — uses DefaultAzureCredential (Managed Identity in Azure,
#                                az login credentials locally)
#   AZURE_STORAGE_CONNECTION_STRING — connection string (Azurite for local dev)
#
# Local dev (Azurite via docker-compose.dev.yml):
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER_NAME=documents
#
# Azure (dev/prod):
# AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>
# AZURE_STORAGE_CONTAINER_NAME=documents

# Cloudflare R2 (fallback / legacy) — used when Azure vars are not set
# Optional Supabase-provider SAML SSO; ignored for Entra/local auth.
SSO_ENABLED=false
# Optional comma-separated exact domain allowlist (no wildcards).
SSO_ALLOWED_DOMAINS=

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# Optional browser-reachable endpoint used only when signing direct-upload
# URLs. Required when R2_ENDPOINT_URL is an internal Docker hostname.
R2_PUBLIC_ENDPOINT_URL=
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

# Workflow ingestion source. The sync job resolves the ref to a full commit
# before downloading. Use a pinned SHA for reproducible production releases.
# An optional private-repository token belongs in Key Vault.
MIKE_WORKFLOWS_REPOSITORY=Open-Legal-Products/mike-workflows
MIKE_WORKFLOWS_REF=main
# MIKE_WORKFLOWS_GITHUB_TOKEN= (local fallback only; use Key Vault in Azure)

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Each var here is a SHARED key used as fallback when a user has not
# pasted a personal key on the Account → Models settings page. Leave any
# unset and that provider becomes "personal-key only" for end users.
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
OPENROUTER_API_KEY=your-openrouter-key
# Organisation router credential (Key Vault: ai-gateway-api-key)
AI_GATEWAY_API_KEY=
# Organisation credential (Key Vault: opencode-api-key)
OPENCODE_API_KEY=

# Optional: enables higher-rate CourtListener case law/citation lookup tools
# (upstream 44e868e). KV secret name: courtlistener-api-token; this env var
# is the local-dev fallback resolveSecret() reads first.
# COURTLISTENER_API_TOKEN=your-courtlistener-token

# Optional: Ed25519 seed (`openssl rand -hex 32`) used to sign project export
# manifests, so a recipient can tell an untouched manifest from an edited one.
# Unset = unsigned manifests (file hashes are still present). In production it
# is resolved from Key Vault as `manifest-signing-key` at boot; this env var is
# the local-dev fallback. Public key: GET /api/manifest-signing-key.
# MANIFEST_SIGNING_KEY=

# Azure OpenAI (shared deployment fallback).  All three of endpoint,
# api_key, and deployment must be set for the provider to be "configured"
# — apiVersion has a sane default in the adapter.  Managed Identity
# auth is on the roadmap; per-tenant AOAI configuration is also
# possible through the Account → Models page.
# AZURE_OPENAI_ENDPOINT=https://your-aoai.openai.azure.com
# AZURE_OPENAI_API_KEY=your-aoai-key
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=gpt-5

# ── Download tokens ──────────────────────────────────────────────────────────
# HMAC secret for signed /download/:token URLs. REQUIRED in production:
# minting a token without it throws per request. In Azure it is resolved
# from Key Vault as `download-signing-secret` (seeded by keyvault.bicep,
# warmed into the process at boot); set this env var for local dev.
# Locally it falls back to a known-weak dev string.
# Recommended: 32+ random chars (openssl rand -base64 32).
# DOWNLOAD_SIGNING_SECRET=

# ── Skills: import analysis model ────────────────────────────────────────────
# Model used to analyse an imported skill package and resolve its capability
# contract. Closer to code review than to the lightweight work the fast model
# exists for, so the deployment can nominate a stronger model without changing
# anyone's chat settings. Unset, or set to an unknown id, falls back to the
# importing administrator's fast model. Analysis always requests a low
# reasoning budget: this is bounded extraction from untrusted text, and a
# larger budget makes the model speculate past what the package requires.
# Note kimi-k3 always reasons and rejects a `thinking` parameter, so `low` is
# as quiet as it gets; kimi-k2.6/k2.5 can disable thinking outright.
# ALTIEN_SKILL_ANALYSIS_MODEL=kimi-k3

# ── Skills: GitHub acquisition ───────────────────────────────────────────────
# Hard deployment-wide deny. TenantAdmin can additionally allow/deny GitHub
# acquisition in Account → Connectors; both gates must allow it.
# ALLOW_GITHUB_SKILL_IMPORTS=false
#
# Optional tenant-level OAuth for private github.com repository reads.
# Register this callback in the GitHub OAuth App:
# http://localhost:3001/api/altien/skills/settings/github/oauth/callback
# Store production values in Key Vault/deployment parameters, not this file.
# GITHUB_SKILL_OAUTH_CLIENT_ID=your-github-oauth-app-client-id
# GITHUB_SKILL_OAUTH_CLIENT_SECRET=your-github-oauth-app-client-secret

# ── Workflows: open-source contributions ─────────────────────────────────────
# Enables POST /workflows/:id/open-source and the "open source" action in the
# workflow page (served to the browser via GET /config
# workflowContributionsEnabled). Off by default; nothing reviews submissions.
# WORKFLOW_CONTRIBUTIONS_ENABLED=false

# Optional async processing. Azure uses the Postgres queue and a dedicated
# worker Container App; Redis/BullMQ is available only when configured.
# REDIS_URL=redis://localhost:6379
# Bounds producer-side Redis commands when an optional Redis instance is unavailable.
# REDIS_PRODUCER_TIMEOUT_MS=5000
# ASYNC_DOCUMENT_CONVERSION=false
# ASYNC_TABULAR_EXTRACTION=false
# STALE_SWEEP_INTERVAL_MS=600000
# DB_JOBS_ENABLED=true
# false stops the runner and makes durable-job producers refuse work; use
# WORKERS_MODE=none to run workers in a separate process or Container App.
# DB_JOBS_POLL_MS=5000
# STALE_DOC_PROCESSING_MS=1800000
# QUEUE_DRIVER=postgres
# WORKERS_MODE=thread
# Job queues. Two transports exist and the app picks one automatically:
#   - Redis configured (REDIS_URL set, or an ASYNC_* flag on) -> BullMQ:
#     instant job pickup + live tabular progress over pub/sub. This is what
#     fresh docker-compose installs run — compose ships a Redis service with
#     the flags on.
#   - No Redis -> the Postgres-backed queue (db_jobs) carries everything
#     durable by default with zero extra infrastructure. Existing bare-metal
#     deployments keep exactly this without touching anything.
# QUEUE_DRIVER accepts "redis" or "postgres" (nothing else — there is no
# "auto" value; leaving it unset IS the automatic behaviour above). Set
# QUEUE_DRIVER=postgres to force the DB queue even with REDIS_URL set.
#QUEUE_DRIVER=postgres
# LEAVE THIS COMMENTED unless you are actually running Redis. Setting
# REDIS_URL is what switches the driver, so an uncommented copy of this line
# points a Redis-less deployment at a Redis that is not there.
#REDIS_URL=redis://localhost:6379
# How long a producer-side Redis command (job delivery, progress publish) may
# take before it is abandoned. Delivery is best-effort — the Postgres row is
# the durable record — so this bounds how long a request can wait on a Redis
# that has gone away. Default 5000.
#REDIS_PRODUCER_TIMEOUT_MS=5000
# Where background workers run relative to the API process:
#   thread (default) — worker_thread in-process, off the HTTP event loop
#   inline           — on the main thread (escape hatch)
#   none             — nowhere here: run `node dist/worker.js` as its own
#                      process/container/machine instead
#WORKERS_MODE=thread
# When "true", DOCX→PDF conversion is enqueued to the BullMQ document-conversion
# queue (uploads return status "processing"; an in-process worker converts and
# flips to "ready"). Requires REDIS_URL + the frontend to poll document status.
# Default "false" runs conversion inline on the request thread.
ASYNC_DOCUMENT_CONVERSION=false
# When "true", tabular-review cell extraction runs on the BullMQ
# tabular-extraction queue (one job per document) instead of inline in the
# POST /tabular-review/:id/generate request. Extraction then survives client
# disconnects + server restarts and retries failed documents; the request tails
# progress over Redis pub/sub and can be resumed via GET .../generate/stream.
# Requires REDIS_URL. Default "false" runs extraction inline.
ASYNC_TABULAR_EXTRACTION=false
# Durable DB-backed background jobs (audit fan-out, account deletion, storage
# cleanup, export builds). Runs BY DEFAULT — needs only Postgres, no Redis.
# Set to "false" only as an operational escape hatch. Producers respect the
# flag too: work that must not be silently acknowledged runs inline instead
# (account deletion falls back to the in-request cascade) or is refused with
# a clear error (async exports answer 503) — nothing is queued for a runner
# that will never come. To run workers on separate hardware, use
# WORKERS_MODE=none here and run `node dist/worker.js` there; that is the
# split-topology switch, not this flag.
#DB_JOBS_ENABLED=true
# How often the runner polls for due jobs (ms). Default 5000.
#DB_JOBS_POLL_MS=5000
# Scoped-memory curation runs only after this many seconds without another
# successfully persisted terminal assistant turn. Default 300 seconds.
# Set this to 10 explicitly in a local test environment when faster feedback is useful.
#MEMORY_INACTIVITY_SECONDS=300
# Crash-recovery lifetime for an active conversation-turn lease. A normal
# response releases or consumes its lease immediately. Default 1800 seconds;
# accepted values are clamped to 60–14400 seconds.
#MEMORY_ACTIVE_LEASE_SECONDS=1800
# Optional deployment-wide override for the separate memory curator. This
# takes precedence over the user's memory-curation model preference. When both
# are unset, Mike uses the model selected for the conversation.
#MEMORY_CURATOR_MODEL=
# Stale-work reaper: documents stuck "processing" longer than this (with no
# live conversion job) are flipped to "error" so the UI never spins forever.
# The sweep runs every STALE_SWEEP_INTERVAL_MS. Defaults: 30 min / 10 min.
#STALE_DOC_PROCESSING_MS=1800000
#STALE_SWEEP_INTERVAL_MS=600000
# Optional: OAuth client used when connecting remote MCP servers that require
# OAuth (Settings → Connectors). Most MCP servers support dynamic client
# registration (RFC 7591) and need nothing here. Google (*.googleapis.com —
# e.g. the Google Drive MCP at https://drivemcp.googleapis.com/mcp/v1) does NOT:
# in Google Cloud Console, create an OAuth client (APIs & Services →
# Credentials → Create credentials → OAuth client ID → Web application) and
# add the callback as an authorized redirect URI. It is derived from
# API_PUBLIC_URL (the frontend gateway, /api prefix included), e.g.
#   http://localhost:3000/api/user/mcp-connectors/oauth/callback
# and enable BOTH services in the same project — the base API *and* the MCP
# service (each Google MCP server has its own): for Drive that is
# drive.googleapis.com AND drivemcp.googleapis.com. A missing MCP service
# surfaces later as "The caller does not have permission" on every tool call
# even though OAuth succeeded.
# Local fallback only; production reads google-mcp-oauth-client-id and
# google-mcp-oauth-client-secret from Key Vault first.
GOOGLE_MCP_OAUTH_CLIENT_ID=
GOOGLE_MCP_OAUTH_CLIENT_SECRET=
# Optional: override the scopes requested from Google; defaults to the scopes
# the MCP server itself advertises.
# GOOGLE_MCP_OAUTH_SCOPE=
# Slack's hosted MCP server (https://mcp.slack.com/mcp) also has no dynamic
# client registration: create a Slack app (https://api.slack.com/apps) with a
# bot user and the agent feature (features.assistant_view), turn on the
# "Slack MCP Server" toggle under the app's Agents settings, enable PKCE under
# OAuth & Permissions, and register
#   https://<your-mike-host>/api/user/mcp-connectors/oauth/callback
# as a redirect URL — Slack requires HTTPS, so local dev needs an HTTPS tunnel
# pointed at the frontend (port 3000) with API_PUBLIC_URL=https://<tunnel>/api
# so the callback matches. A ready-made app manifest lives in
# docs/slack-mcp-app-manifest.example.json.
# Local fallback only; production reads slack-mcp-oauth-client-id and
# slack-mcp-oauth-client-secret from Key Vault first.
SLACK_MCP_OAUTH_CLIENT_ID=
SLACK_MCP_OAUTH_CLIENT_SECRET=
# Optional: override the user scopes requested from Slack; defaults to the
# scopes the MCP server itself advertises.
# SLACK_MCP_OAUTH_SCOPE=
# Optional fallback scope for dynamically registered MCP OAuth clients.
# MCP_OAUTH_DEFAULT_SCOPE=

# Alias for ANTHROPIC_API_KEY, accepted when that one is unset. The key-status
# endpoint has always honoured it; lib/llm/providers.ts now does too.
CLAUDE_API_KEY=
# Optional local/OpenAI-compatible provider (Ollama, vLLM, LiteLLM, Open WebUI).
# Base URL default: http://localhost:11434/v1
OLLAMA_BASE_URL=
# Model tag used when the model id is a bare "ollama" (default: qwen3.6).
OLLAMA_MODEL=
# Bearer token — bare Ollama needs none, gateways in front of it usually do.
OLLAMA_API_KEY=

# When "true", CourtListener lookups read the bulk citation/cluster index in
# Supabase + R2 first and only fall back to the API. Default "false".
COURTLISTENER_BULK_DATA_ENABLED=false
# When "true", the workflow contribution ("submit to open source") endpoints
# are enabled. Default "false".
WORKFLOW_CONTRIBUTIONS_ENABLED=false

# Encrypts the stored auth config of user MCP connectors. Falls back to
# USER_API_KEYS_ENCRYPTION_SECRET when unset. Generate with: openssl rand -hex 32
MCP_CONNECTORS_ENCRYPTION_SECRET=

# --- Rate limits ----------------------------------------------------------
# Express rate-limiter windows and per-window request caps (app.ts). Every one
# is optional; the commented value is the built-in default. The auth and
# upload-session limiters are documented in their own sections above.
#RATE_LIMIT_GENERAL_WINDOW_MINUTES=15
#RATE_LIMIT_GENERAL_MAX=300
#RATE_LIMIT_CHAT_WINDOW_MINUTES=15
#RATE_LIMIT_CHAT_MAX=30
#RATE_LIMIT_CHAT_CREATE_WINDOW_MINUTES=15
#RATE_LIMIT_CHAT_CREATE_MAX=60
#RATE_LIMIT_UPLOAD_WINDOW_HOURS=1
#RATE_LIMIT_UPLOAD_MAX=50
#RATE_LIMIT_EXPORT_WINDOW_HOURS=1
#RATE_LIMIT_EXPORT_MAX=10
#RATE_LIMIT_DATA_DELETE_WINDOW_HOURS=1
#RATE_LIMIT_DATA_DELETE_MAX=20
# Number of proxy hops Express trusts when deriving the client IP that the
# limiters key on. Default 1.
#TRUST_PROXY_HOPS=1

# --- Debug logging --------------------------------------------------------
# NEVER ENABLE IN PRODUCTION — these write privileged client content (the full
# prompt, documents, and model output) to the process log and to disk in the
# clear. Both are hard-disabled when NODE_ENV=production.
# When "true", every raw LLM stream chunk is dumped to the console.
LOG_RAW_LLM_STREAM=false
# When set, each LLM stream is also written verbatim to a JSON file in this
# directory. Leave empty to keep the recorder off.
RAW_LLM_STREAM_LOG_DIR=

# --- Local integration tests ----------------------------------------------
# Only read by the *.supabase.test.ts suites (npm run test:stack); they skip
# themselves when these are unset. Point them at a LOCAL Supabase stack.
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_ANON_KEY=
