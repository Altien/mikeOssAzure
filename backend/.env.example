NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Browser-reachable frontend gateway used for OAuth callbacks, including MCP
# connectors. In production this must be HTTPS and include the `/api` prefix.
API_PUBLIC_URL=http://localhost:3000/api
# Public task-pane origin for deployed Word add-ins. Local development uses the
# same-origin webpack proxy and does not need this entry.
WORD_ADDIN_URL=
# Required when WORD_ADDIN_URL is set. Generate with: openssl rand -hex 32
# This encrypts the short-lived, single-use OAuth handoff stored in Postgres.
AUTH_HANDOFF_ENCRYPTION_SECRET=
# Defaults to 120 seconds and is constrained to 30-300 seconds.
AUTH_HANDOFF_TTL_SECONDS=120
# Optional comma-separated origins for additional trusted clients.
ALLOWED_ORIGINS=

# Packaged optional modules exposed by this deployment. Accepts `all`, `none`,
# or a comma-separated subset of the keys below. User toggles are applied after
# this deployment-level allow-list.
MIKE_ENABLED_MODULES=all
# Available keys: promptLibrary,legalMonitors,playbooks,ironclad,gmail,localModels,committeeModels,patentConnector

# Optional private built-in prompt data. The backend also checks
# ./data/mikeExamplePrompts.json. The file is intentionally not distributed
# with MikeOSS; when absent, personal prompts continue to work normally.
# MIKE_BUILTIN_PROMPTS_PATH=/absolute/path/to/mikeExamplePrompts.json

# Persistence provider. Supabase is the upstream-compatible default.
MIKE_DATABASE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
# Public/anon key used by the backend's per-request user-session client. It is
# server-side here; the service-role key is never used for browser sessions.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Authentication-specific throttles. Successful logins do not consume the two
# login budgets; failed attempts are limited by both IP and normalized account.
RATE_LIMIT_AUTH_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_LOGIN_MAX=30
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_ACCOUNT_MAX=10
RATE_LIMIT_AUTH_EMAIL_WINDOW_HOURS=1
RATE_LIMIT_AUTH_EMAIL_MAX=10
RATE_LIMIT_AUTH_FLOW_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_FLOW_MAX=30
RATE_LIMIT_AUTH_MFA_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MFA_MAX=20

# Upload-session control and status-polling throttles. Invalid or missing values
# fall back to these defaults. The create limit is also enforced in Postgres.
RATE_LIMIT_UPLOAD_SESSION_MUTATION_WINDOW_MINUTES=15
RATE_LIMIT_UPLOAD_SESSION_MUTATION_MAX=300
RATE_LIMIT_UPLOAD_SESSION_POLL_WINDOW_MINUTES=15
RATE_LIMIT_UPLOAD_SESSION_POLL_MAX=3000
RATE_LIMIT_UPLOAD_SESSION_CREATE_MAX_PER_HOUR=50

# Background upload processing. Each backend replica may process this many jobs
# concurrently, while the per-user cap prevents one large batch from occupying
# the entire pool. Invalid values use these defaults; concurrency is capped at
# 64 and the per-user value cannot exceed the process-wide concurrency.
UPLOAD_PROCESSING_CONCURRENCY=8
UPLOAD_PROCESSING_MAX_RUNNING_PER_USER=2

# Hard deadlines that stop a wedged conversion from holding a worker slot. The
# LibreOffice child is killed after the conversion timeout; a worker stops
# renewing its job lease after the wall-clock budget so another worker can
# steal and retry the job. Values are clamped to the ranges shown.
# UPLOAD_CONVERT_TIMEOUT_MS: 10000-600000, UPLOAD_JOB_WALL_CLOCK_MS: 60000-3600000
UPLOAD_CONVERT_TIMEOUT_MS=120000
UPLOAD_JOB_WALL_CLOCK_MS=900000

# Local Supabase CLI Google OAuth credentials. Google is enabled by default;
# set [auth.external.google].enabled to false to opt out locally.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from other application secrets.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string

# Optional local alternative. Set MIKE_DATABASE_PROVIDER=sqlite to use it.
# SQLite requires a Node runtime that provides node:sqlite.
# SQLITE_DB_PATH=./data/mike.sqlite

# Object storage provider. Cloudflare R2 is the upstream-compatible default.
MIKE_STORAGE_PROVIDER=r2
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# Optional browser-reachable endpoint used only when signing direct-upload
# URLs. Required when R2_ENDPOINT_URL is an internal Docker hostname.
R2_PUBLIC_ENDPOINT_URL=
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mike

# Workflow ingestion source. The sync job resolves this ref to a commit before
# downloading. Pin a 40-character commit SHA for reproducible production
# releases. A token is only needed for private repositories or higher API limits.
MIKE_WORKFLOWS_REPOSITORY=Open-Legal-Products/mike-workflows
MIKE_WORKFLOWS_REF=main
MIKE_WORKFLOWS_GITHUB_TOKEN=

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# Optional router keys. Users can also save either key in Settings.
# Enables the searchable OpenRouter model catalog.
OPENROUTER_API_KEY=your-openrouter-key
# Enables the Vercel AI Gateway router catalog.
AI_GATEWAY_API_KEY=
# Enables the OpenCode Go router catalog.
OPENCODE_API_KEY=
# Enables the Synthetic router catalog.
SYNTHETIC_API_KEY=
# Optional: playbook compilation inherits LLM_REQUEST_TIMEOUT_MS when set and
# otherwise allows five minutes per model attempt.
# PLAYBOOK_COMPILATION_TIMEOUT_MS=300000
RESEND_API_KEY=your-resend-key
# Optional sender used for legal monitor alerts. The domain must be verified in Resend.
LEGAL_MONITOR_FROM_EMAIL=Mike Legal Monitor <alerts@your-domain.example>
# Optional scheduler controls. Defaults: enabled and a 60-second due-work poll.
LEGAL_MONITOR_SCHEDULER_ENABLED=true
LEGAL_MONITOR_POLL_INTERVAL_MS=60000
# Optional environment-specific monitor template. Keep false for vanilla MikeOSS.
LEGAL_MONITOR_FINTECH_PRESET_ENABLED=false
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# Optional Gmail knowledge-base import and monitor email delivery.
# Create a Google OAuth 2.0 Web application and register the callback URL.
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# Defaults to API_PUBLIC_URL/integrations/gmail/oauth/callback when omitted.
GMAIL_REDIRECT_URI=http://localhost:3001/integrations/gmail/oauth/callback

# Optional credentials for the managed USPTO Patent & Trademark MCP connector.
# Public PPUBS patent and trademark-search tools work without these keys.
USPTO_API_KEY=your-uspto-open-data-portal-key
TSDR_API_KEY=your-uspto-tsdr-key
# Optional token used by the trademark-search client when USPTO WAF protection requires it.
TMSEARCH_WAF_TOKEN=your-uspto-trademark-search-waf-token
# Optional local checkout; when omitted Mike runs the pinned PyPI package via uvx.
# PATENT_MCP_DIRECTORY=/absolute/path/to/patent_mcp_server
# Defaults to backend/data/uv, which must be writable by the backend user.
# PATENT_MCP_UV_DATA_DIR=/absolute/path/to/a/writable/uv-data-directory

# Optional: enables Kimi K3/K3-256K as cloud OpenAI-compatible model options.
KIMI_API_KEY=your-kimi-code-api-key

# Optional: configure local/cloud models and committee models.
# OpenAI-compatible local servers include Ollama, LM Studio, vLLM, and LocalAI.
# Example:
# MIKE_MODEL_CONFIG_JSON={"models":[{"id":"local-llama","provider":"openai-compatible","location":"local","apiModel":"llama3.1","baseUrl":"http://localhost:11434/v1"}],"committees":[{"id":"legal-committee","members":["local-llama","gpt-5.4-lite","claude-haiku-4-5"],"chair":"gpt-5.4-lite"}]}

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token

# Optional: Ed25519 seed used to sign project export manifests, so a recipient
# can tell an untouched manifest from an edited one. Leave it unset to export
# unsigned manifests: the file hashes are still there, the manifest itself is
# just unattested.
# Generate with: openssl rand -hex 32
# Use a dedicated secret. The matching public key is served at
# GET /manifest-signing-key. Rotating the key does not invalidate past exports,
# but whoever checks one needs the key that was current when it was made.
MANIFEST_SIGNING_KEY=

# Job queues. Two transports exist and the app picks one automatically:
#   - Redis configured (REDIS_URL set, or an ASYNC_* flag on) -> BullMQ:
#     instant job pickup + live tabular progress over pub/sub. This is what
#     fresh docker-compose installs run — compose ships a Redis service with
#     the flags on.
#   - No Redis -> the Postgres-backed queue (db_jobs) carries everything
#     durable by default with zero extra infrastructure. Existing bare-metal
#     deployments keep exactly this without touching anything.
# QUEUE_DRIVER accepts "redis" or "postgres" (nothing else — there is no
# "auto" value; leaving it unset IS the automatic behaviour above). Set
# QUEUE_DRIVER=postgres to force the DB queue even with REDIS_URL set.
#QUEUE_DRIVER=postgres
# LEAVE THIS COMMENTED unless you are actually running Redis. Setting
# REDIS_URL is what switches the driver, so an uncommented copy of this line
# points a Redis-less deployment at a Redis that is not there.
#REDIS_URL=redis://localhost:6379
# How long a producer-side Redis command (job delivery, progress publish) may
# take before it is abandoned. Delivery is best-effort — the Postgres row is
# the durable record — so this bounds how long a request can wait on a Redis
# that has gone away. Default 5000.
#REDIS_PRODUCER_TIMEOUT_MS=5000
# Where background workers run relative to the API process:
#   thread (default) — worker_thread in-process, off the HTTP event loop
#   inline           — on the main thread (escape hatch)
#   none             — nowhere here: run `node dist/worker.js` as its own
#                      process/container/machine instead
#WORKERS_MODE=thread
# When "true", DOCX→PDF conversion is enqueued to the BullMQ document-conversion
# queue (uploads return status "processing"; an in-process worker converts and
# flips to "ready"). Requires REDIS_URL + the frontend to poll document status.
# Default "false" runs conversion inline on the request thread.
ASYNC_DOCUMENT_CONVERSION=false
# When "true", tabular-review cell extraction runs on the BullMQ
# tabular-extraction queue (one job per document) instead of inline in the
# POST /tabular-review/:id/generate request. Extraction then survives client
# disconnects + server restarts and retries failed documents; the request tails
# progress over Redis pub/sub and can be resumed via GET .../generate/stream.
# Requires REDIS_URL. Default "false" runs extraction inline.
ASYNC_TABULAR_EXTRACTION=false
# Durable DB-backed background jobs (audit fan-out, account deletion, storage
# cleanup, export builds). Runs BY DEFAULT — needs only Postgres, no Redis.
# Set to "false" only as an operational escape hatch. Producers respect the
# flag too: work that must not be silently acknowledged runs inline instead
# (account deletion falls back to the in-request cascade) or is refused with
# a clear error (async exports answer 503) — nothing is queued for a runner
# that will never come. To run workers on separate hardware, use
# WORKERS_MODE=none here and run `node dist/worker.js` there; that is the
# split-topology switch, not this flag.
#DB_JOBS_ENABLED=true
# How often the runner polls for due jobs (ms). Default 5000.
#DB_JOBS_POLL_MS=5000
# Stale-work reaper: documents stuck "processing" longer than this (with no
# live conversion job) are flipped to "error" so the UI never spins forever.
# The sweep runs every STALE_SWEEP_INTERVAL_MS. Defaults: 30 min / 10 min.
#STALE_DOC_PROCESSING_MS=1800000
#STALE_SWEEP_INTERVAL_MS=600000
