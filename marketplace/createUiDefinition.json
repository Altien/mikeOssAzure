{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": true,
      "basics": {
        "description": "Deploy the Mike AI stack — VNet, Postgres Flexible Server, PostgREST, backend Container App, Key Vault and Storage — into your own Azure subscription. You will need an Anthropic and/or OpenAI API key to enable AI features."
      }
    },
    "basics": [
      {
        "name": "envSuffix",
        "type": "Microsoft.Common.TextBox",
        "label": "Environment suffix",
        "defaultValue": "prod",
        "toolTip": "Short suffix used in all resource names (e.g. dev, prod, demo). Lowercase letters and digits only.",
        "constraints": {
          "required": true,
          "regex": "^[a-z0-9]{2,10}$",
          "validationMessage": "2–10 lowercase letters or digits."
        }
      }
    ],
    "steps": [
      {
        "name": "database",
        "label": "Database",
        "elements": [
          {
            "name": "pgAdminUser",
            "type": "Microsoft.Common.TextBox",
            "label": "PostgreSQL admin username",
            "defaultValue": "mikeadmin",
            "toolTip": "Admin username for the Postgres Flexible Server.",
            "constraints": {
              "required": true,
              "regex": "^[a-z][a-z0-9_]{2,62}$",
              "validationMessage": "Lowercase, starts with a letter, 3–63 chars."
            }
          },
          {
            "name": "pgAdminPassword",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "PostgreSQL admin password",
              "confirmPassword": "Confirm password"
            },
            "toolTip": "Min 12 chars, mix of upper/lower/digit/symbol. Stored only in your subscription's Postgres server — never in deployment logs.",
            "constraints": {
              "required": true,
              "regex": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{12,128}$",
              "validationMessage": "12+ chars with upper, lower, and a digit."
            },
            "options": {
              "hideConfirmation": false
            }
          },
          {
            "name": "pgSkuTier",
            "type": "Microsoft.Common.DropDown",
            "label": "Compute tier",
            "defaultValue": "Burstable B2s (2 vCPU, 4 GB)",
            "toolTip": "Postgres Flexible Server SKU. Burstable is cheapest; General Purpose is required for HA.",
            "constraints": {
              "allowedValues": [
                { "label": "Burstable B2s (2 vCPU, 4 GB)",  "value": { "name": "Standard_B2s",  "tier": "Burstable" } },
                { "label": "Burstable B1ms (1 vCPU, 2 GB)", "value": { "name": "Standard_B1ms", "tier": "Burstable" } },
                { "label": "General Purpose D2ds_v5 (2 vCPU, 8 GB)", "value": { "name": "Standard_D2ds_v5", "tier": "GeneralPurpose" } }
              ],
              "required": true
            }
          },
          {
            "name": "pgStorageGb",
            "type": "Microsoft.Common.DropDown",
            "label": "Storage (GB)",
            "defaultValue": "32",
            "toolTip": "Initial storage. Can be grown later but not shrunk.",
            "constraints": {
              "allowedValues": [
                { "label": "32",  "value": 32 },
                { "label": "64",  "value": 64 },
                { "label": "128", "value": 128 },
                { "label": "256", "value": 256 }
              ],
              "required": true
            }
          },
          {
            "name": "pgBackupRetentionDays",
            "type": "Microsoft.Common.Slider",
            "label": "Backup retention (days)",
            "defaultValue": 7,
            "min": 7,
            "max": 35,
            "toolTip": "Postgres point-in-time backup retention window."
          },
          {
            "name": "enableHa",
            "type": "Microsoft.Common.CheckBox",
            "label": "Enable zone-redundant HA (requires General Purpose)",
            "defaultValue": false,
            "toolTip": "Adds a standby replica in a separate availability zone. Requires the General Purpose tier and roughly doubles the Postgres cost."
          }
        ]
      },
      {
        "name": "networking",
        "label": "Networking",
        "elements": [
          {
            "name": "enableNatGateway",
            "type": "Microsoft.Common.CheckBox",
            "label": "Provision NAT Gateway (recommended for production)",
            "defaultValue": true,
            "toolTip": "Gives outbound traffic a stable public IP. Adds ~30 USD/month — disable for low-cost dev environments."
          }
        ]
      }
    ],
    "outputs": {
      "env": "[basics('envSuffix')]",
      "location": "[location()]",
      "pgAdminUser": "[steps('database').pgAdminUser]",
      "pgAdminPassword": "[steps('database').pgAdminPassword]",
      "pgSku": "[steps('database').pgSkuTier]",
      "pgStorageGb": "[int(steps('database').pgStorageGb)]",
      "pgBackupRetentionDays": "[int(steps('database').pgBackupRetentionDays)]",
      "enableHa": "[steps('database').enableHa]",
      "enableNatGateway": "[steps('networking').enableNatGateway]",
      "createAcr": false,
      "acrSku": "Standard",
      "imagePullAuth": "anonymous",
      "containerRegistry": "acrmikeoss.azurecr.io",
      "backendImage": "acrmikeoss.azurecr.io/backend:__VERSION__",
      "postgrestImage": "acrmikeoss.azurecr.io/postgrest:v12.2.3"
    }
  }
}
