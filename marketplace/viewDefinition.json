{
  "$schema": "https://schema.management.azure.com/schemas/viewdefinition/0.0.1-preview/ViewDefinition.json#",
  "contentVersion": "1.0.0.0",
  "views": [
    {
      "kind": "Overview",
      "properties": {
        "header": "Mike AI",
        "description": "AI document workflow stack — Postgres, PostgREST, backend Container App, Key Vault and Storage deployed inside your subscription.",
        "commands": [
          {
            "displayName": "Run database migration",
            "path": "runMigration",
            "icon": "Refresh"
          },
          {
            "displayName": "Open backend health endpoint",
            "path": "openBackendHealth",
            "icon": "Link"
          }
        ]
      }
    },
    {
      "kind": "Properties",
      "properties": {
        "displayName": "Endpoints",
        "fact": [
          {
            "displayName": "Backend FQDN",
            "path": "outputs.backendFqdn"
          },
          {
            "displayName": "Backend health URL",
            "path": "outputs.backendHealthUrl"
          },
          {
            "displayName": "PostgreSQL FQDN",
            "path": "outputs.pgFqdn"
          },
          {
            "displayName": "Container Registry",
            "path": "outputs.acrLoginServer"
          },
          {
            "displayName": "Key Vault",
            "path": "outputs.keyVaultName"
          },
          {
            "displayName": "Storage account",
            "path": "outputs.storageAccountName"
          }
        ]
      }
    },
    {
      "kind": "Associations",
      "properties": {
        "displayName": "Deployed resources",
        "resourceTypes": [
          "Microsoft.App/containerApps",
          "Microsoft.App/jobs",
          "Microsoft.App/managedEnvironments",
          "Microsoft.DBforPostgreSQL/flexibleServers",
          "Microsoft.KeyVault/vaults",
          "Microsoft.Storage/storageAccounts",
          "Microsoft.ContainerRegistry/registries",
          "Microsoft.Network/virtualNetworks"
        ]
      }
    }
  ]
}
